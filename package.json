{
  "name": "qdf-gtfs",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "src",
    "binding.gyp"
  ],
  "scripts": {
    "test": "tsx test.ts",
    "build": "tsc",
    "install": "node-gyp rebuild",
    "prepare": "npm run build",
    "benchmark:core": "nub run build && node --expose-gc benchmarks/core.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  }
}
